# ==============================================================================
# CampusOS Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local to configure upstream services.
# NOTE: If no external keys are provided, CampusOS runs automatically in
# transparent Pedagogical Demo Mode with seeded local fixtures.
# Never commit actual secret keys or .env.local files to source control!
# ==============================================================================

# Application Environment
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 1. AI Provider Configuration (Optional for Live Production)
# ------------------------------------------------------------------------------
# If set, CampusOS will query live upstream models.
# If omitted or unset, CampusOS uses its built-in verified pedagogical engine.
CAMPUSOS_AI_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 2. Supabase PostgreSQL & Auth Configuration (Optional for Cloud DB)
# ------------------------------------------------------------------------------
# In local development mode, CampusOS persists user state and attempts in localStorage.
# For production PostgreSQL persistence, provide your Supabase instance credentials:
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-private-key

# ------------------------------------------------------------------------------
# 3. Security & Rate Limiting Controls
# ------------------------------------------------------------------------------
AI_RATE_LIMIT_MAX_PER_MINUTE=15
CODEPLAY_EXECUTION_TIMEOUT_MS=5000
